#!/usr/bin/env bash
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref pushed.
zero=0000000000000000000000000000000000000000
status=0
while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$zero" ]] && continue
  if [[ "$rsha" == "$zero" ]]; then range="origin/main..$lsha"; else range="$rsha..$lsha"; fi
  bash "$(git rev-parse --show-toplevel)/scripts/check-embargo.sh" range "$range" || status=$?
done
exit $status
